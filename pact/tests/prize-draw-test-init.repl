;; prize-draw-test-init.repl — self-contained environment for the prize-draw
;; suites: a namespace, the coin stack, the keysets, the drand verifier the draw
;; checks its beacon with, the revenue account, and the module.
;;
;; The module reads its namespace from transaction data at load, so ONE source
;; deploys unchanged into a devnet namespace and a mainnet principal one; the
;; suites use "smartpacts". The drand verifier is DIFFERENT: the module names it
;; `n_48867b242317a0216a67f8c7ca26696b5878e0e3.drand`, pinned to its code hash, so
;; the fixture loads it under exactly that name, as mainnet has it.
;;
;; Beacons. A round is pinned to the drand round published DRAND-MARGIN-SECONDS
;; after its draw instant, and only drand's genuine signature for that round
;; verifies. The suites therefore draw with REAL evmnet signatures, fetched once
;; and kept in `fixtures/beacons.repl` (the `beacons` module); `(beacons.sig-for
;; id seq)` returns the one for a round's pinned drand round and aborts, naming
;; the round, when it is missing. Scenario clocks are therefore in the PAST:
;; a beacon for a future round does not exist yet.

;; ---- namespaces --------------------------------------------------------------
(env-data { "ns-admin": ["476f5e8a97ad059ab4a585666252db4cc65404f0dbec9db72257d99fe276ebef"] })
(begin-tx)
(module test-ns GOVERNANCE
  (defcap GOVERNANCE () (enforce-guard (read-keyset "ns-admin")))
  (defconst NS-GUARD (create-user-guard (succeed)))
  (defun succeed () true))
(define-namespace "smartpacts" test-ns.NS-GUARD test-ns.NS-GUARD)
(define-namespace "free"       test-ns.NS-GUARD test-ns.NS-GUARD)
(commit-tx)
(env-data {})

;; ---- coin stack (root namespace) --------------------------------------------
(begin-tx)
(load "../vendor/fixtures/fungible-v2.pact")
(load "../vendor/fixtures/fungible-xchain-v1.pact")
(load "../vendor/fixtures/coin.pact")
(create-table coin.coin-table)
(create-table coin.allocation-table)
(commit-tx)

;; ---- keysets ----------------------------------------------------------------
;; admin (GOVERNANCE) and operator are DIFFERENT keys on purpose: every test that
;; proves the operator cannot upgrade, and that governance is a separate trust
;; boundary, depends on it. The drand verifier needs no keyset at all: it is
;; sealed, with no governance that can ever pass.
(env-data
  { "admin":       ["476f5e8a97ad059ab4a585666252db4cc65404f0dbec9db72257d99fe276ebef"]
  , "operator":    ["09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"] })
(begin-tx)
(namespace "smartpacts")
(define-keyset "smartpacts.prize-draw-admin"            (read-keyset "admin"))
(define-keyset "smartpacts.prize-draw-operator"         (read-keyset "operator"))
(commit-tx)

;; ---- the drand verifier — the DEPLOYED sealed source, vendored verbatim -------
;; Loaded under its mainnet name because the module names it fully and PINS its
;; code hash; the verifier is dependency-free, so the REPL computes mainnet's hash
;; for it. Loaded under any other name or bytes, the module refuses to load — and
;; that refusal is itself pinned.
(begin-tx)
(define-namespace "n_48867b242317a0216a67f8c7ca26696b5878e0e3" test-ns.NS-GUARD test-ns.NS-GUARD)
(load "../vendor/drand.pact")
(commit-tx)
(env-chain-data { "chain-id": "1", "block-height": 100, "sender": "deployer"
                , "block-time": (time "2026-01-01T00:00:00Z") })

;; ---- the revenue account -----------------------------------------------------
;; prize-draw does NOT import a module for this: the destination is recorded at
;; initialize and must already exist.
(begin-tx)
(env-data { "rev": ["a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f0098709b0f41a2f2b3b9f0c8ab6"] })
(coin.create-account "draw-revenue" (read-keyset "rev"))
(commit-tx)

;; ---- two more funded personas -------------------------------------------------
;; Funded far beyond anything a suite stakes. They exist so a suite has accounts
;; beyond the players it funds itself — a second buyer, a crank payee.
(env-data
  { "seal-ks":  { "keys": ["5ea1000000000000000000000000000000000000000000000000000000000001"], "pred": "keys-all" }
  , "seal2-ks": { "keys": ["5ea1000000000000000000000000000000000000000000000000000000000002"], "pred": "keys-all" } })
(begin-tx)
(test-capability (coin.COINBASE))
(coin.coinbase "k:5ea1000000000000000000000000000000000000000000000000000000000001" (read-keyset "seal-ks")  10000000.0)
(coin.coinbase "k:5ea1000000000000000000000000000000000000000000000000000000000002" (read-keyset "seal2-ks") 10000000.0)
(commit-tx)
(env-data {})

;; ---- smartpacts.prize-draw --------------------------------------------------
;; The load-time (enforce-guard <ns>.prize-draw-admin) needs the admin signature.
(env-sigs [ { "key": "476f5e8a97ad059ab4a585666252db4cc65404f0dbec9db72257d99fe276ebef", "caps": [] } ])
(env-data { "ns": "smartpacts", "init": true })
(begin-tx)
(load "../modules/prize-draw.pact")
(commit-tx)
(env-sigs [])
(env-data {})

;; ---- genuine drand evmnet beacons for the scenarios' pinned rounds ----------
(begin-tx)
(load "fixtures/beacons.repl")
(commit-tx)

(print "prize-draw test environment ready")
