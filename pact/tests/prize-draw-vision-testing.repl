;; prize-draw-vision-testing.repl
;;
;; Requirements the FOUNDER stated, each pinned by a test that goes RED if the
;; requirement is violated. This file exists because of a specific failure mode:
;; an audit asks "is it safe and correct", never "is it what was asked for", and
;; a test suite encodes the implementer's belief — so a wrong belief produces a
;; green suite forever.
;;
;; It is not a duplicate of the unit suite. Every test here was written after a
;; planted mutation SURVIVED the unit suite, or pins a vision clause the unit
;; suite never states.
;;
;; ONE drand beacon decides a round: there is no sealer, no secret, no bond, no
;; reveal, no opening step and no recorder. A round exists from its FIRST
;; TICKET, which freezes the terms and the calendar and pins the drand round
;; published DRAND-MARGIN-SECONDS after the draw instant — after the last ticket
;; could sell. Only drand's genuine signature for exactly that round verifies,
;; and the draw is a pure function of the round key and that beacon. So nobody
;; can know the winner while a ticket can still be bought, and whoever sends the
;; draw chooses nothing.
;;
;; The drawn scenarios are dated in the PAST: they draw with real evmnet
;; signatures from `fixtures/beacons.repl`, and a future round has none yet.
;;
;;   pact pact/tests/prize-draw-vision-testing.repl


(load "prize-draw-test-init.repl")

(begin-tx)
(env-data
  { "v1": { "keys": ["1111111111111111111111111111111111111111111111111111111111111111"], "pred": "keys-all" }
  , "v2": { "keys": ["2222222222222222222222222222222222222222222222222222222222222222"], "pred": "keys-all" } })
(test-capability (coin.COINBASE))
(coin.coinbase "k:1111111111111111111111111111111111111111111111111111111111111111" (read-keyset "v1") 1000.0)
(coin.coinbase "k:2222222222222222222222222222222222222222222222222222222222222222" (read-keyset "v2") 1000.0)
(commit-tx)

(begin-tx)
(env-sigs [ { "key": "476f5e8a97ad059ab4a585666252db4cc65404f0dbec9db72257d99fe276ebef"
            , "caps": [ (smartpacts.prize-draw.GOVERNANCE) ] } ])
(smartpacts.prize-draw.initialize "draw-revenue")
(commit-tx)
(env-sigs [])

;; ===========================================================================
;; FOUNDER: "it should be modular, we should be able to change it. it should
;;           not be able to change for open raffles."
;;
;; The unit suite proves the round ROW is untouched by a mid-round set-terms.
;; It does NOT prove the SETTLEMENT uses the frozen terms, because its fixture
;; restores the original rake before every draw — so the live row and the
;; frozen row agree by the time anything is paid.
;;
;; Mutation M-RAKE, run 2026-09-07: change `draw` to read the rake from the
;; live `raffles` row instead of the frozen `rounds` row. The unit suite stayed
;; GREEN (exit 0, zero FAILUREs). An operator could therefore have raised the
;; fee on a round that was already selling, and nothing would have caught it.
;;
;; The tests below leave the raised fee IN PLACE across the draw. That is the
;; whole point: the live row and the frozen row must DISAGREE at settlement.
;; ===========================================================================

(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(smartpacts.prize-draw.create-raffle "frozen" 10.0 0.05 [1.0] 0 false 0.0 0 200.0 0.20 [1 1])
(commit-tx)
(env-sigs [])

;; ten tickets at 10.0 => sales 100.0, frozen rake 0.05 => fee 5.0, fund 95.0
;; A round sells and draws by CALENDAR instants the operator names for it:
;; sells Sep 16 00:00 to Sep 20 06:00, draws at Sep 20 14:00. The FIRST TICKET
;; is what creates the round and freezes those instants with every other term,
;; so it is the first ticket that this whole section's "frozen at open" claim
;; rests on. The draw instant fixes the drand round that decides the round:
;; the one published at 14:02:58, round 20797302.
(begin-tx)
(env-chain-data { "block-height": 500, "block-time": (time "2026-09-15T12:00:00Z") })
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(smartpacts.prize-draw.schedule-round "frozen"
  (time "2026-09-16T00:00:00Z") (time "2026-09-20T06:00:00Z") (time "2026-09-20T14:00:00Z"))
(expect "VISION-0 no round exists before the first ticket — a schedule is not a round"
  "" (at 'current (smartpacts.prize-draw.get-raffle "frozen")))
(commit-tx)
(env-sigs [])

(begin-tx)
(env-chain-data { "block-height": 500, "block-time": (time "2026-09-16T00:00:00Z") })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111"
                                       (smartpacts.prize-draw.pool-account "frozen") 100.0) ] } ])
(expect "VISION-0b the first ticket creates round 1"
  "bought 10 ticket(s) in frozen round 1"
  (smartpacts.prize-draw.buy "frozen" "k:1111111111111111111111111111111111111111111111111111111111111111" 10 [] (at 'expect (smartpacts.prize-draw.ticket-terms "frozen"))))
(commit-tx)
(env-sigs [])

(begin-tx)
(expect "VISION-1a the round froze the rake it opened with" 0.05
  (at 'rake (smartpacts.prize-draw.get-round "frozen" 1)))
(expect "VISION-1b the round froze the price it opened with" 10.0
  (at 'price (smartpacts.prize-draw.get-round "frozen" 1)))
(expect "VISION-1c the round froze the instants it opened with, and pinned the drand round published DRAND-MARGIN-SECONDS after its draw instant"
  { "opens-at": (time "2026-09-16T00:00:00Z"), "closes-at": (time "2026-09-20T06:00:00Z")
  , "draws-at": (time "2026-09-20T14:00:00Z"), "decide-height": 20797302 }
  (let ((r (smartpacts.prize-draw.get-round "frozen" 1)))
    { "opens-at": (at 'opens-at r), "closes-at": (at 'closes-at r)
    , "draws-at": (at 'draws-at r), "decide-height": (at 'decide-height r) }))
(commit-tx)

;; The operator raises the fee to 90% AND names a different, shorter calendar
;; for the NEXT round WHILE this round is selling, and — unlike the unit suite —
;; never puts either back. The next round cannot open before this one closes
;; (no ticket could ever start it), so the calendar it names starts after
;; Sep 20 06:00 but draws EARLIER than this round does.
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(expect "VISION-2 the operator CAN change future terms — the raffle is modular"
  "raffle frozen re-termed for future rounds"
  (smartpacts.prize-draw.set-terms "frozen" 99.0 0.90 [1.0] 0 0.0 0 200.0 0.20 [1 1]))
(expect-failure "VISION-2b but CANNOT name a next round that opens while this one still sells — no ticket could ever start it"
  "the next round cannot open before the current one closes at 2026-09-20T06:00:00Z"
  (smartpacts.prize-draw.schedule-round "frozen"
    (time "2026-09-16T01:00:00Z") (time "2026-09-16T02:00:00Z") (time "2026-09-16T02:00:00Z")))
(expect "VISION-2c and CAN name a shorter calendar for the NEXT round, drawing before this one does"
  "raffle frozen next round: sells 2026-09-20T07:00:00Z to 2026-09-20T08:00:00Z, draws at 2026-09-20T08:00:00Z"
  (smartpacts.prize-draw.schedule-round "frozen"
    (time "2026-09-20T07:00:00Z") (time "2026-09-20T08:00:00Z") (time "2026-09-20T08:00:00Z")))
(commit-tx)
(env-sigs [])

(begin-tx)
(expect "VISION-3 the LIVE raffle row now carries the raised fee and the next calendar"
  { "rake": 0.90, "next-opens-at": (time "2026-09-20T07:00:00Z"), "next-draws-at": (time "2026-09-20T08:00:00Z") }
  (let ((g (smartpacts.prize-draw.get-raffle "frozen")))
    { "rake": (at 'rake g), "next-opens-at": (at 'next-opens-at g), "next-draws-at": (at 'next-draws-at g) }))
(expect "VISION-4 the OPEN round still carries the fee it opened with" 0.05
  (at 'rake (smartpacts.prize-draw.get-round "frozen" 1)))
(expect "VISION-4b and still sells and draws on the instants it opened with — an earlier calendar cannot pull the draw forward"
  { "closes-at": (time "2026-09-20T06:00:00Z"), "draws-at": (time "2026-09-20T14:00:00Z"), "decide-height": 20797302 }
  (let ((r (smartpacts.prize-draw.get-round "frozen" 1)))
    { "closes-at": (at 'closes-at r), "draws-at": (at 'draws-at r), "decide-height": (at 'decide-height r) }))
(commit-tx)

;; The earlier draw instant the operator just named passes, and drand publishes
;; the beacon that instant would pin — this round is closed by then, awaiting
;; its own draw. That beacon belongs to the NEXT round, so it decides nothing here.
(begin-tx)
(env-chain-data { "block-height": 510, "block-time": (time "2026-09-20T08:02:58Z") })
(expect "VISION-4b2 at the earlier instant named for the next round, THIS round is not decidable" false
  (smartpacts.prize-draw.decidable "frozen" 1))
(expect-failure "VISION-4b3 and the beacon that earlier instant pins does not draw it"
  "drand signature does not verify"
  (smartpacts.prize-draw.draw "frozen" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig (smartpacts.prize-draw.drand-round-for
                   (at 'next-draws-at (smartpacts.prize-draw.get-raffle "frozen"))))))
(rollback-tx)

;; ===========================================================================
;; FOUNDER: ONE drand beacon decides the round, and nobody can know the winner
;; while a ticket can still be bought. The first ticket pins the drand round
;; published DRAND-MARGIN-SECONDS after the draw instant; before drand publishes
;; it, no signature that exists verifies; from that moment anyone can compute
;; the winner and anyone can send the draw; the draw is a pure function of the
;; round key and that beacon; and a settled round's result equals what
;; `preview` returned to anyone who asked before the draw was sent.
;;
;; Each clause is a NAMED test that goes RED if it is violated.
;; ===========================================================================

;; ---- before drand publishes the pinned round: NOTHING ------------------------
;; Sales closed at 06:00, the draw instant was 14:00, and drand publishes round
;; 20797302 at 14:02:58. A second before, every beacon that exists is refused.
(begin-tx)
(env-chain-data { "block-height": 519, "block-time": (time "2026-09-20T14:02:57Z") })
(expect "VISION-BLOCK-0 a second before drand publishes the pinned round, its beacon is not due" false
  (at 'beacon-due (smartpacts.prize-draw.draw-status "frozen" 1)))
(expect "VISION-BLOCK-0b so nothing that exists before the draw moment can decide it: the pinned drand round is published after sales close and after the draw instant"
  { "drand-round": 20797302, "beacon-at": (time "2026-09-20T14:02:58Z")
  , "after-close": true, "after-draw-instant": true, "beacon-due": false }
  (let ((d (smartpacts.prize-draw.draw-status "frozen" 1))
        (r (smartpacts.prize-draw.get-round "frozen" 1)))
    { "drand-round": (at 'drand-round d), "beacon-at": (at 'beacon-at d)
    , "after-close": (> (at 'beacon-at d) (at 'closes-at r))
    , "after-draw-instant": (> (at 'beacon-at d) (at 'draws-at r))
    , "beacon-due": (at 'beacon-due d) }))
(expect "VISION-BLOCK-0c nothing is decidable" false
  (smartpacts.prize-draw.decidable "frozen" 1))
;; round 20797242 is the one published at or before the draw instant itself —
;; the latest beacon anyone could hold at 14:00
(expect-failure "VISION-BLOCK-0d the preview names nobody from any beacon that already exists: the one published by the draw instant is refused"
  "drand signature does not verify"
  (smartpacts.prize-draw.preview "frozen" 1 (beacons.sig 20797242)))
(expect-failure "VISION-BLOCK-0e and the draw refuses"
  "drand signature does not verify"
  (smartpacts.prize-draw.draw "frozen" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig 20797242)))
;; round 20787642 is the one published at the instant sales closed
(expect-failure "VISION-BLOCK-0f nor does the beacon published when sales closed"
  "drand signature does not verify"
  (smartpacts.prize-draw.draw "frozen" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig 20787642)))
(rollback-tx)

;; ---- the moment drand publishes: decidable, with nothing to open -------------
(begin-tx)
(env-chain-data { "block-height": 520, "block-time": (time "2026-09-20T14:02:58Z") })
(expect "VISION-BLOCK-1 the moment drand publishes the pinned round the round is decidable — nobody had to open or record anything"
  true (smartpacts.prize-draw.decidable "frozen" 1))
(expect "VISION-BLOCK-1b draw-status names the pinned drand round, when drand publishes it, and from when the round could escape"
  { "state": "selling", "tickets": 10, "draws-at": (time "2026-09-20T14:00:00Z")
  , "drand-round": 20797302, "beacon-at": (time "2026-09-20T14:02:58Z"), "beacon-due": true
  , "escape-from": (time "2026-12-19T14:02:58Z") }
  (smartpacts.prize-draw.draw-status "frozen" 1))
(commit-tx)

;; ---- only the genuine signature for exactly that round decides ----------------
;; Every refusal is proven on `draw`, the path that moves money; the last one on
;; `preview` too, which shares the verification.
(begin-tx)
(env-chain-data { "block-height": 521, "block-time": (time "2026-09-20T14:03:00Z") })
(let* ((sig (beacons.sig-for "frozen" 1))
       (flipped (+ (take 127 sig) (if (= (drop 127 sig) "0") "1" "0")))
       ; the SAME curve point with x written as x + P: still 64 bytes, still hex
       (noncanon (+ (int-to-str 16 (+ (str-to-int 16 (take 64 sig))
                                      n_48867b242317a0216a67f8c7ca26696b5878e0e3.drand.P))
                    (drop 64 sig)))
       (payee "k:2222222222222222222222222222222222222222222222222222222222222222"))
  (expect-failure "VISION-BLOCK-2 drand's genuine signature for the NEXT drand round does not draw the round"
    "drand signature does not verify"
    (smartpacts.prize-draw.draw "frozen" 1 payee (beacons.sig 20797303)))
  (expect-failure "VISION-BLOCK-2b the pinned round's own signature with one hex digit altered does not draw it"
    "Point lies outside of elliptic curve"
    (smartpacts.prize-draw.draw "frozen" 1 payee flipped))
  (expect-failure "VISION-BLOCK-2c the point at infinity is refused as a signature"
    "the point at infinity is not a signature"
    (smartpacts.prize-draw.draw "frozen" 1 payee (concat (make-list 128 "0"))))
  (expect-failure "VISION-BLOCK-2d a truncated signature is refused"
    "G1 must be 64 bytes"
    (smartpacts.prize-draw.draw "frozen" 1 payee (take 126 sig)))
  (expect-failure "VISION-BLOCK-2e a second encoding of the genuine signature (x + P) is refused, so one beacon never yields two seeds"
    "G1 coordinates must be canonical"
    (smartpacts.prize-draw.draw "frozen" 1 payee noncanon))
  (expect-failure "VISION-BLOCK-2f a signature that is not hex is refused"
    "invalid digit"
    (smartpacts.prize-draw.draw "frozen" 1 payee (+ "zz" (drop 2 sig))))
  (expect-failure "VISION-BLOCK-2g and the preview refuses the next round's signature exactly as the draw does"
    "drand signature does not verify"
    (smartpacts.prize-draw.preview "frozen" 1 (beacons.sig 20797303))))
(rollback-tx)

;; ---- nothing about the sending transaction changes the outcome ---------------
;; A block-decided draw read the block; this one reads none. The same beacon
;; previewed from two different heights, block hashes and senders names the
;; same seed, winners and amounts.
(begin-tx)
(let* ((sig (beacons.sig-for "frozen" 1))
       (a (env-chain-data { "block-height": 600, "block-time": (time "2026-09-20T14:03:00Z")
                          , "prev-block-hash": "qP4mXe2NbVc7ZaLdKrTyHuGjFsEoWiRxBn0Mv9Ct3Yk"
                          , "sender": "k:2222222222222222222222222222222222222222222222222222222222222222" }))
       (p1 (smartpacts.prize-draw.preview "frozen" 1 sig))
       (b (env-chain-data { "block-height": 987654, "block-time": (time "2026-09-27T09:00:00Z")
                          , "prev-block-hash": "Zt3bLm8QwXc1VpRnKe6YuHaGdJsFi2OoNv0Mr9Cy5Tk"
                          , "sender": "k:5ea1000000000000000000000000000000000000000000000000000000000001" }))
       (p2 (smartpacts.prize-draw.preview "frozen" 1 sig)))
  (expect "VISION-BLOCK-3 block height, block hash, clock and sender cannot change the outcome: two previews under different block data agree"
    p1 p2))
(rollback-tx)

;; ---- the draw is a PURE FUNCTION of the round key and the beacon -------------
;; Recomputed HERE, straight from the drand verifier and the round key, then
;; compared with the row the draw wrote. The preview is captured BEFORE the draw
;; is sent and compared with the settled row afterwards.
(begin-tx)
(env-chain-data { "block-height": 700, "block-time": (time "2026-09-20T14:03:00Z")
                , "sender": "k:2222222222222222222222222222222222222222222222222222222222222222" })
(let* ((rk (smartpacts.prize-draw.round-key "frozen" 1))
       (sig (beacons.sig-for "frozen" 1))
       (seed (mod (n_48867b242317a0216a67f8c7ca26696b5878e0e3.drand.verified-seed
                    (format "prize-draw|{}" [rk]) 20797302 sig)
                  1000000000000000000))
       (ranks (smartpacts.prize-draw.draw-ranks seed rk 10 1))
       (pv (smartpacts.prize-draw.preview "frozen" 1 sig))
       (before (coin.get-balance "k:1111111111111111111111111111111111111111111111111111111111111111")))
  (smartpacts.prize-draw.draw "frozen" 1
    "k:2222222222222222222222222222222222222222222222222222222222222222" sig)
  (let ((rd (smartpacts.prize-draw.get-round "frozen" 1))
        (paid (- (coin.get-balance "k:1111111111111111111111111111111111111111111111111111111111111111") before)))
    (expect "VISION-BLOCK-4 the settled seed is the drand verifier's seed for the round key and the pinned round's beacon, recomputed here"
      seed (at 'draw-seed rd))
    (expect "VISION-BLOCK-4b the settled ranks are draw-ranks of that seed, recomputed here"
      ranks (at 'ranks rd))
    (expect "VISION-BLOCK-4c the settled round equals what preview returned before the draw was sent"
      { "drand-round": (at 'drand-round pv), "draw-seed": (at 'draw-seed pv), "ranks": (at 'ranks pv)
      , "amounts": (at 'amounts pv), "accounts": (at 'accounts pv) }
      { "drand-round": (at 'deciding-block rd), "draw-seed": (at 'draw-seed rd), "ranks": (at 'ranks rd)
      , "amounts": (at 'amounts rd), "accounts": (at 'accounts rd) })
    ;; sole buyer holds every ticket, so the single tier pays the whole fund to
    ;; them. At the FROZEN 5% fee the fund is 95.0. At the raised 90% fee it
    ;; would be 10.0 — an 85 KDA difference this assertion cannot miss.
    (print (format "VISION: buyer received {} (95.0 = frozen 5% fee, 10.0 = live 90% fee)" [paid]))
    (expect "VISION-5 SETTLEMENT used the FROZEN fee, not the operator's mid-round raise"
      95.0 paid)))
(commit-tx)

(begin-tx)
(let ((rd (smartpacts.prize-draw.get-round "frozen" 1)))
  (expect "VISION-6 the round settled" "drawn" (at 'state rd))
  (expect "VISION-7 the whole frozen-fee fund was paid out" [95.0] (at 'amounts rd)))
(expect "VISION-8 the pool is empty — the raised fee took nothing extra" 0.0
  (coin.get-balance (smartpacts.prize-draw.pool-account "frozen")))
(commit-tx)

;; ===========================================================================
;; FOUNDER: "winners paid automatically, nothing to claim."
;; Pinned structurally: a claim entry point for a DRAWN round must not exist.
;; claim-escape is the escape path only, and must refuse a drawn round.
;; ===========================================================================
(begin-tx)
(expect-failure "VISION-9 there is no claim step for a drawn round"
  "did not escape"
  (smartpacts.prize-draw.claim-escape "frozen" 1
    "k:1111111111111111111111111111111111111111111111111111111111111111"))
(rollback-tx)

;; ===========================================================================
;; FOUNDER (2026-09-15): "the operator names when a raffle sells and draws, by
;; calendar instants, and can change them for the next round until its first
;; ticket; a round's instants are frozen at its first ticket; nothing can
;; decide a round before its draw instant."
;;
;; Four clauses, each a NAMED test that goes RED if it is violated. Every gate
;; pinned here is a CLOCK gate, and the drand round a round is decided by is
;; derived from its frozen draw instant.
;; ===========================================================================
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(smartpacts.prize-draw.create-raffle "cal" 1.0 0.05 [1.0] 0 false 0.0 0 200.0 0.20 [1 1])
(commit-tx)

;; ---- clause 1: the OPERATOR names the instants ------------------------------
(begin-tx)
(env-chain-data { "block-height": 800, "block-time": (time "2026-09-01T00:00:00Z") })
(expect "VISION-CAL-1 the operator names when the next round sells and draws, as calendar instants"
  "raffle cal next round: sells 2026-09-02T00:00:00Z to 2026-09-03T00:00:00Z, draws at 2026-09-03T12:00:00Z"
  (smartpacts.prize-draw.schedule-round "cal"
    (time "2026-09-02T00:00:00Z") (time "2026-09-03T00:00:00Z") (time "2026-09-03T12:00:00Z")))
(expect "VISION-CAL-1b the raffle carries exactly those three instants for its next round"
  { "opens": (time "2026-09-02T00:00:00Z"), "closes": (time "2026-09-03T00:00:00Z"), "draws": (time "2026-09-03T12:00:00Z") }
  (let ((g (smartpacts.prize-draw.get-raffle "cal")))
    { "opens": (at 'next-opens-at g), "closes": (at 'next-closes-at g), "draws": (at 'next-draws-at g) }))
(commit-tx)
(env-sigs [])

(begin-tx)
(expect-failure "VISION-CAL-1c nobody but the operator names them"
  "Keyset failure"
  (smartpacts.prize-draw.schedule-round "cal"
    (time "2026-09-02T00:00:00Z") (time "2026-09-03T00:00:00Z") (time "2026-09-03T12:00:00Z")))
(rollback-tx)

;; ---- clause 2: changeable for the NEXT round until its first ticket ----------
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(expect "VISION-CAL-2 before any ticket, the operator can move the next round's instants"
  "raffle cal next round: sells 2026-09-05T00:00:00Z to 2026-09-06T00:00:00Z, draws at 2026-09-06T06:00:00Z"
  (smartpacts.prize-draw.schedule-round "cal"
    (time "2026-09-05T00:00:00Z") (time "2026-09-06T00:00:00Z") (time "2026-09-06T06:00:00Z")))
(expect "VISION-CAL-2b and the later call is the one that stands"
  { "opens": (time "2026-09-05T00:00:00Z"), "closes": (time "2026-09-06T00:00:00Z"), "draws": (time "2026-09-06T06:00:00Z") }
  (let ((g (smartpacts.prize-draw.get-raffle "cal")))
    { "opens": (at 'next-opens-at g), "closes": (at 'next-closes-at g), "draws": (at 'next-draws-at g) }))
(commit-tx)
(env-sigs [])

;; ---- clause 1, the selling half, and clause 3: the FIRST TICKET freezes -------
;; Tickets sell exactly between the instants, and the first one is what creates
;; the round, freezes the instants that stood when it landed, and pins the drand
;; round those instants imply.
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111"
                                       (smartpacts.prize-draw.pool-account "cal") 1.0) ] } ])
(begin-tx)
(env-chain-data { "block-height": 802, "block-time": (time "2026-09-04T23:59:59Z") })
(expect-failure "VISION-CAL-4a no ticket sells before the instant the operator named — and so no round exists"
  "sales have not opened yet — they open at 2026-09-05T00:00:00Z"
  (smartpacts.prize-draw.buy "cal" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (at 'expect (smartpacts.prize-draw.ticket-terms "cal"))))
(expect "VISION-CAL-4a2 no round row exists before the first ticket" ""
  (at 'current (smartpacts.prize-draw.get-raffle "cal")))
(rollback-tx)
(begin-tx)
(env-chain-data { "block-height": 803, "block-time": (time "2026-09-05T00:00:00Z") })
(expect "VISION-CAL-3 the first ticket sells at that instant, creates the round and freezes the instants that stood when it landed"
  "bought 1 ticket(s) in cal round 1"
  (smartpacts.prize-draw.buy "cal" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (at 'expect (smartpacts.prize-draw.ticket-terms "cal"))))
(expect "VISION-CAL-3b the round row carries them"
  { "opens": (time "2026-09-05T00:00:00Z"), "closes": (time "2026-09-06T00:00:00Z"), "draws": (time "2026-09-06T06:00:00Z") }
  (let ((r (smartpacts.prize-draw.get-round "cal" 1)))
    { "opens": (at 'opens-at r), "closes": (at 'closes-at r), "draws": (at 'draws-at r) }))
(expect "VISION-CAL-3b2 and the first ticket already pinned the drand round that will decide it, derived from the frozen draw instant"
  { "decide-height": 20384502, "derived": 20384502 }
  { "decide-height": (at 'decide-height (smartpacts.prize-draw.get-round "cal" 1))
  , "derived": (smartpacts.prize-draw.drand-round-for (time "2026-09-06T06:00:00Z")) })
(expect "VISION-CAL-3c the first ticket consumed the schedule — the round after this one needs its own"
  { "opens": (time "1970-01-01T00:00:00Z"), "closes": (time "1970-01-01T00:00:00Z"), "draws": (time "1970-01-01T00:00:00Z") }
  (let ((g (smartpacts.prize-draw.get-raffle "cal")))
    { "opens": (at 'next-opens-at g), "closes": (at 'next-closes-at g), "draws": (at 'next-draws-at g) }))
(commit-tx)
(begin-tx)
(env-chain-data { "block-height": 803, "block-time": (time "2026-09-05T12:00:00Z") })
(expect "VISION-CAL-4b a later ticket joins the round inside the window"
  "bought 1 ticket(s) in cal round 1"
  (smartpacts.prize-draw.buy "cal" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (at 'expect (smartpacts.prize-draw.ticket-terms "cal"))))
(commit-tx)
(begin-tx)
(env-chain-data { "block-height": 804, "block-time": (time "2026-09-06T00:00:00Z") })
(expect-failure "VISION-CAL-4c and none at the instant sales close"
  "sales are closed for this round"
  (smartpacts.prize-draw.buy "cal" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (at 'expect (smartpacts.prize-draw.ticket-terms "cal"))))
(rollback-tx)
(env-sigs [])

(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(expect "VISION-CAL-3d a schedule named after the first ticket belongs to the NEXT round"
  "raffle cal next round: sells 2026-09-10T00:00:00Z to 2026-09-11T00:00:00Z, draws at 2026-09-11T06:00:00Z"
  (smartpacts.prize-draw.schedule-round "cal"
    (time "2026-09-10T00:00:00Z") (time "2026-09-11T00:00:00Z") (time "2026-09-11T06:00:00Z")))
(expect "VISION-CAL-3e and leaves the live round's instants exactly where its first ticket froze them"
  { "opens": (time "2026-09-05T00:00:00Z"), "closes": (time "2026-09-06T00:00:00Z"), "draws": (time "2026-09-06T06:00:00Z") }
  (let ((r (smartpacts.prize-draw.get-round "cal" 1)))
    { "opens": (at 'opens-at r), "closes": (at 'closes-at r), "draws": (at 'draws-at r) }))
(commit-tx)
(env-sigs [])

;; ---- clause 4: NOTHING decides a round before its beacon exists --------------
;; Sales closed at 00:00, the draw instant was 06:00, and drand publishes the
;; pinned round 20384502 at 06:02:58. A second before, no beacon that exists
;; draws or previews the round, and it cannot escape.
(begin-tx)
(env-chain-data { "block-height": 820, "block-time": (time "2026-09-06T06:02:57Z") })
;; round 20377242 was published at 2026-09-05T23:59:58Z, while a ticket could still sell
(expect-failure "VISION-CAL-5 nobody can draw it with the beacon drand published while the last ticket could still sell"
  "drand signature does not verify"
  (smartpacts.prize-draw.draw "cal" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig (n_48867b242317a0216a67f8c7ca26696b5878e0e3.drand.round-at (time "2026-09-05T23:59:59Z")))))
(expect "VISION-CAL-5b a second before drand publishes it, the round reports its pinned drand round, not yet due, and nothing decidable"
  { "drand-round": 20384502, "beacon-due": false, "decidable": false }
  { "drand-round": (at 'drand-round (smartpacts.prize-draw.draw-status "cal" 1))
  , "beacon-due": (at 'beacon-due (smartpacts.prize-draw.draw-status "cal" 1))
  , "decidable": (smartpacts.prize-draw.decidable "cal" 1) })
;; round 20384442 is the one published at or before the draw instant itself
(expect-failure "VISION-CAL-5c nor with the beacon published at its draw instant — the pinned round lies DRAND-MARGIN-SECONDS beyond it"
  "drand signature does not verify"
  (smartpacts.prize-draw.draw "cal" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig 20384442)))
(expect-failure "VISION-CAL-5d the preview names no winner"
  "drand signature does not verify"
  (smartpacts.prize-draw.preview "cal" 1 (beacons.sig 20384442)))
(expect-failure "VISION-CAL-5e nor can an escape settle the round out from under its buyers"
  "this round can still be drawn — it may escape only if nobody draws it by 2026-12-05T06:02:58Z"
  (smartpacts.prize-draw.escape "cal" 1))
(rollback-tx)

(begin-tx)
(env-chain-data { "block-height": 820, "block-time": (time "2026-09-06T06:02:58Z") })
(expect "VISION-CAL-6 the moment drand publishes the pinned round, the round is decidable — nobody opens anything"
  true (smartpacts.prize-draw.decidable "cal" 1))
(expect "VISION-CAL-6b the round pins its drand round at the first ticket, and drand publishes it DRAND-MARGIN-SECONDS after draws-at — after the last ticket could sell, so nobody can know the winner while a ticket can still be bought"
  { "drand-round": 20384502, "beacon-at": (time "2026-09-06T06:02:58Z")
  , "margin": 180.0, "after-last-sale": true }
  (let ((r (smartpacts.prize-draw.get-round "cal" 1)))
    { "drand-round": (at 'decide-height r)
    , "beacon-at": (n_48867b242317a0216a67f8c7ca26696b5878e0e3.drand.time-of-round (at 'decide-height r))
    , "margin": smartpacts.prize-draw.DRAND-MARGIN-SECONDS
    , "after-last-sale": (> (n_48867b242317a0216a67f8c7ca26696b5878e0e3.drand.time-of-round (at 'decide-height r))
                            (at 'closes-at r)) }))
(commit-tx)

;; ---- VISION-CAL-WRAP: an absurd instant cannot be scheduled -----------------
;; Pact's `diff-time` and `add-time` work in int64 microseconds and wrap silently
;; (engine: CoreBuiltin.hs, `diffTime` = PactTime subtraction). An instant past
;; the edge reads as the deep past, so BOTH sides of every bound are needed: the
;; lower bound catches a wrapped opens-at, the upper bounds catch a wrapped
;; closes-at and draws-at. Relaxing any one of them turns one of these red.
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(env-chain-data { "block-height": 900, "block-time": (time "2026-11-06T06:00:00Z") })
(begin-tx)
(smartpacts.prize-draw.create-raffle "wrapr" 1.0 0.05 [1.0] 0 false 0.0 0 200.0 0.20 [1 1])
(let ((edge (add-time (add-time (time "2026-11-06T06:00:00Z") 9223372036854.775807) 1.0)))
  (expect "VISION-CAL-WRAP-0 the engine wraps: one second past the int64 edge reads as the deep past" true
    (< (diff-time edge (time "2026-11-06T06:00:00Z")) 0.0))
  (expect-failure "VISION-CAL-WRAP-1 a wrapped opens-at is refused as the past" "sales cannot open in the past"
    (smartpacts.prize-draw.schedule-round "wrapr" edge (time "2026-12-01T00:00:00Z") (time "2026-12-01T00:00:00Z")))
  (expect-failure "VISION-CAL-WRAP-2 a wrapped closes-at is refused by the sales ceiling" "sales may stay open at most"
    (smartpacts.prize-draw.schedule-round "wrapr" (time "2026-11-07T00:00:00Z") edge (time "2026-12-01T00:00:00Z")))
  (expect-failure "VISION-CAL-WRAP-3 a wrapped draws-at is refused by the draw-gap ceiling" "the draw must come within"
    (smartpacts.prize-draw.schedule-round "wrapr" (time "2026-11-07T00:00:00Z") (time "2026-11-08T00:00:00Z") edge)))
;; A SECOND wrap distance, and the one that matters most: an instant far enough past
;; the edge that the difference wraps back to a large POSITIVE number. The lower
;; bound sees a future instant and lets it through; only the lead ceiling refuses it.
;; Measured 2026-09-16: (time "0294248-01-10T04:00:54Z") reads back as the year
;; -290307, and its difference from a 2026 clock is +9,221,614,099,254 seconds.
;; This is the test that goes red if MAX-LEAD-SECONDS is ever relaxed.
(let ((far (time "0294248-01-10T04:00:54Z")))
  (expect "VISION-CAL-WRAP-4 the far instant itself wraps to the deep past" true
    (< far (time "2026-11-06T06:00:00Z")))
  (expect "VISION-CAL-WRAP-4b yet its difference from the clock reads POSITIVE, so the lower bound cannot catch it" true
    (> (diff-time far (time "2026-11-06T06:00:00Z")) 0.0))
  (expect-failure "VISION-CAL-WRAP-5 and the LEAD ceiling is what refuses it" "sales cannot open more than"
    (smartpacts.prize-draw.schedule-round "wrapr" far (time "2026-12-01T00:00:00Z") (time "2026-12-01T00:00:00Z"))))
(rollback-tx)
(env-sigs [])

;; ===========================================================================
;; FOUNDER: the draw is SIMPLE. After the operator schedules, a whole round
;; needs exactly TWO transactions: the first ticket and the draw. Nothing to
;; open, record, seal, reveal or claim.
;;
;; Pinned by COUNTING: the calls are collected in one REPL transaction whose
;; chain data is advanced between them the way blocks would be, the list is two
;; long and the round is drawn at its end; no shorter prefix leaves the round
;; drawn (asserted between the calls); and a further call of any settling kind
;; is refused afterwards.
;; ===========================================================================
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(env-chain-data { "block-height": 890, "block-time": (time "2026-09-15T00:00:00Z") })
(smartpacts.prize-draw.create-raffle "simple" 1.0 0.05 [1.0] 0 false 0.0 0 200.0 0.20 [1 1])
(smartpacts.prize-draw.schedule-round "simple"
  (time "2026-09-16T00:00:00Z") (time "2026-09-17T00:00:00Z") (time "2026-09-17T06:00:00Z"))
(commit-tx)
(env-sigs [])

(begin-tx)
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111"
                                       (smartpacts.prize-draw.pool-account "simple") 2.0) ] } ])
(let* ((buyer "k:1111111111111111111111111111111111111111111111111111111111111111")
       ;; 1. the first ticket, inside the sales window
       (t1 (env-chain-data { "block-height": 900, "block-time": (time "2026-09-16T00:00:00Z") }))
       (s1 (smartpacts.prize-draw.buy "simple" buyer 2 [] (at 'expect (smartpacts.prize-draw.ticket-terms "simple"))))
       (d1 (smartpacts.prize-draw.decidable "simple" 1))
       ;; the draw instant passes; drand has not published the pinned round yet
       (t2 (env-chain-data { "block-height": 920, "block-time": (time "2026-09-17T06:00:00Z") }))
       (d2 (smartpacts.prize-draw.decidable "simple" 1))
       ;; drand publishes the pinned round (20701302) at 06:02:58
       (t3 (env-chain-data { "block-height": 923, "block-time": (time "2026-09-17T06:02:58Z")
                           , "sender": "k:2222222222222222222222222222222222222222222222222222222222222222" }))
       (d3 (smartpacts.prize-draw.decidable "simple" 1))
       ;; 2. the draw, with that beacon
       (s2 (smartpacts.prize-draw.draw "simple" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
             (beacons.sig-for "simple" 1)))
       (steps [s1 s2]))
  (expect "VISION-SIMPLE-1 after scheduling, exactly two calls take a round from nothing to drawn" 2 (length steps))
  (expect "VISION-SIMPLE-1b and they are: the first ticket, then the draw"
    [ "bought 2 ticket(s) in simple round 1" ]
    (take 1 steps))
  (expect "VISION-SIMPLE-1c the second settles it" "drawn"
    (at 'state (smartpacts.prize-draw.get-round "simple" 1)))
  (expect "VISION-SIMPLE-2 no shorter prefix could have: after the ticket, and at the draw instant, nothing is decidable; once drand publishes the pinned round it is"
    [false false true] [d1 d2 d3]))
(commit-tx)
(env-sigs [])

(begin-tx)
(expect-failure "VISION-SIMPLE-3 there is no further call: a drawn round cannot be drawn again"
  "this round is already settled"
  (smartpacts.prize-draw.draw "simple" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig-for "simple" 1)))
(expect-failure "VISION-SIMPLE-3b nor reported as awaiting a draw" "this round is settled — read get-round for its result"
  (smartpacts.prize-draw.draw-status "simple" 1))
(expect-failure "VISION-SIMPLE-3c nor escaped" "this round is settled"
  (smartpacts.prize-draw.escape "simple" 1))
(expect-failure "VISION-SIMPLE-3d nor claimed — the winner was paid inside the draw" "did not escape"
  (smartpacts.prize-draw.claim-escape "simple" 1 "k:1111111111111111111111111111111111111111111111111111111111111111"))
(rollback-tx)

;; ===========================================================================
;; FOUNDER: no party INFLUENCES the outcome. The drand round is pinned at the
;; first ticket; only drand's genuine signature for exactly that round
;; verifies, so a drawer cannot pick a neighbouring beacon, wait for a better
;; one, or bring block data it likes; and once decide-height and deciding-block
;; are written, no public function rewrites either.
;; ===========================================================================
;; two buyers, two tiers, so the ranks and the accounts are not trivial
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(env-chain-data { "block-height": 940, "block-time": (time "2026-09-19T00:00:00Z") })
(smartpacts.prize-draw.create-raffle "infl" 1.0 0.05 [0.7 0.3] 0 false 0.0 0 200.0 0.20 [1 1])
(smartpacts.prize-draw.schedule-round "infl"
  (time "2026-09-20T00:00:00Z") (time "2026-09-21T00:00:00Z") (time "2026-09-21T06:00:00Z"))
(commit-tx)
(env-sigs [])
(begin-tx)
(env-chain-data { "block-height": 950, "block-time": (time "2026-09-20T00:00:00Z") })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111"
                                       (smartpacts.prize-draw.pool-account "infl") 6.0) ] } ])
(smartpacts.prize-draw.buy "infl" "k:1111111111111111111111111111111111111111111111111111111111111111" 6 [] (at 'expect (smartpacts.prize-draw.ticket-terms "infl")))
(env-sigs [ { "key": "2222222222222222222222222222222222222222222222222222222222222222"
            , "caps": [ (coin.TRANSFER "k:2222222222222222222222222222222222222222222222222222222222222222"
                                       (smartpacts.prize-draw.pool-account "infl") 4.0) ] } ])
(smartpacts.prize-draw.buy "infl" "k:2222222222222222222222222222222222222222222222222222222222222222" 4 [] (at 'expect (smartpacts.prize-draw.ticket-terms "infl")))
(commit-tx)
(env-sigs [])

;; draws at Sep 21 06:00 => drand round 20816502, published 06:02:58
(begin-tx)
(expect "VISION-INFLUENCE-0 the first ticket pinned the round's drand round, and nothing is decided"
  { "decide-height": 20816502, "deciding-block": -1 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(commit-tx)

;; ---- decide-height, once written, is rewritten by NOTHING --------------------
;; Every public function that writes is tried after the beacon is published and
;; before the draw, and the pair (decide-height, deciding-block) is read back
;; after each. Refusals roll back; successes that would clutter the rest of the
;; file roll back too, AFTER the assertion. The pure helpers (round-seed,
;; draw-ranks, tier-amounts, merge-payee, lift, draw-candidate, drand-round-for,
;; the key builders, validate-*) contain no table write and cannot be the rewriter.
(begin-tx)
(env-chain-data { "block-height": 1001, "block-time": (time "2026-09-21T06:02:58Z") })
(expect-failure "VISION-INFLUENCE-1a a draw with drand's genuine signature for the PREVIOUS drand round is refused"
  "drand signature does not verify"
  (smartpacts.prize-draw.draw "infl" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig 20816501)))
(expect-failure "VISION-INFLUENCE-1b a draw with the signature for the NEXT drand round is refused — waiting for a later beacon picks nothing"
  "drand signature does not verify"
  (smartpacts.prize-draw.draw "infl" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig 20816503)))
(expect-failure "VISION-INFLUENCE-1c preview with a neighbouring round's signature is refused"
  "drand signature does not verify"
  (smartpacts.prize-draw.preview "infl" 1 (beacons.sig 20816503)))
(expect-failure "VISION-INFLUENCE-1d escape while the round can still be drawn is refused" "this round can still be drawn"
  (smartpacts.prize-draw.escape "infl" 1))
(expect-failure "VISION-INFLUENCE-1e claim-escape on a round that did not escape is refused" "did not escape"
  (smartpacts.prize-draw.claim-escape "infl" 1 "k:1111111111111111111111111111111111111111111111111111111111111111"))
(expect-failure "VISION-INFLUENCE-1g a ticket into a closed round is refused" "sales are closed for this round"
  (smartpacts.prize-draw.buy "infl" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (at 'expect (smartpacts.prize-draw.ticket-terms "infl"))))
(expect "VISION-INFLUENCE-1h the pair stands: the drand round pinned, nothing decided"
  { "decide-height": 20816502, "deciding-block": -1 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(rollback-tx)

;; even the admin, signing, cannot initialize twice: the state row is insert-once
(begin-tx)
(env-sigs [ { "key": "476f5e8a97ad059ab4a585666252db4cc65404f0dbec9db72257d99fe276ebef"
            , "caps": [ (smartpacts.prize-draw.GOVERNANCE) ] } ])
(expect-failure "VISION-INFLUENCE-1f a second initialize is refused even with the admin's signature" "already found"
  (smartpacts.prize-draw.initialize "draw-revenue"))
(rollback-tx)
(env-sigs [])

(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] }
          , { "key": "5ea1000000000000000000000000000000000000000000000000000000000001"
            , "caps": [ (coin.TRANSFER "k:5ea1000000000000000000000000000000000000000000000000000000000001"
                                       (smartpacts.prize-draw.pool-account "infl") 1.0) ] } ])
(smartpacts.prize-draw.set-terms "infl" 2.0 0.50 [1.0] 0 1.0 0 200.0 0.20 [1 0])
(smartpacts.prize-draw.seed-raffle "infl" "k:5ea1000000000000000000000000000000000000000000000000000000000001" 1.0)
(smartpacts.prize-draw.create-raffle "infl-2" 1.0 0.05 [1.0] 0 false 0.0 0 200.0 0.20 [1 1])
(expect "VISION-INFLUENCE-1i set-terms, seed-raffle and create-raffle leave the pair untouched"
  { "decide-height": 20816502, "deciding-block": -1 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(rollback-tx)
(env-sigs [])

(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(smartpacts.prize-draw.retire-raffle "infl")
(expect "VISION-INFLUENCE-1j retire-raffle leaves the pair untouched"
  { "decide-height": 20816502, "deciding-block": -1 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(rollback-tx)
(env-sigs [])

;; the next round's schedule, kept: it is what lets a LATER buy open round 2
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(smartpacts.prize-draw.schedule-round "infl"
  (time "2026-09-22T00:00:00Z") (time "2026-09-22T01:00:00Z") (time "2026-09-22T01:00:00Z"))
(expect "VISION-INFLUENCE-1k schedule-round leaves the pair untouched"
  { "decide-height": 20816502, "deciding-block": -1 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(commit-tx)
(env-sigs [])

;; ---- whoever sends it, whenever, from whatever block: the same winners -------
;; Two would-be drawers preview the round from different heights, block hashes,
;; clocks and senders. Everything they could vary is varied; the pinned beacon
;; is the only input, so both see the same seed, the same winners and the same
;; amounts.
(begin-tx)
(let* ((sig (beacons.sig-for "infl" 1))
       (a (env-chain-data { "block-height": 1004, "block-time": (time "2026-09-21T06:02:58Z")
                          , "prev-block-hash": "In1fL3uEnCe4bLoCk1003aAbBcCdDeEfFgGhHiIjJkK"
                          , "sender": "k:5ea1000000000000000000000000000000000000000000000000000000000001" }))
       (p1 (smartpacts.prize-draw.preview "infl" 1 sig))
       (b (env-chain-data { "block-height": 5005, "block-time": (time "2026-10-30T11:00:00Z")
                          , "prev-block-hash": "In1fL3uEnCe4bLoCk1004zZyYxXwWvVuUtTsSrRqQpP"
                          , "sender": "k:2222222222222222222222222222222222222222222222222222222222222222" }))
       (p2 (smartpacts.prize-draw.preview "infl" 1 sig)))
  (expect "VISION-INFLUENCE-2 two would-be drawers at different heights, hashes, clocks and senders preview the same seed"
    (at 'draw-seed p1) (at 'draw-seed p2))
  (expect "VISION-INFLUENCE-2b and the same two winning tickets"
    (at 'ranks p1) (at 'ranks p2))
  (expect "VISION-INFLUENCE-2d whoever sends the draw and whenever, the winners and prizes are the ones the pinned beacon fixes"
    p1 p2))
(rollback-tx)

;; the draw, sent by the second persona
(begin-tx)
(env-chain-data { "block-height": 1006, "block-time": (time "2026-09-21T06:03:00Z")
                , "sender": "k:2222222222222222222222222222222222222222222222222222222222222222" })
(env-events true)
(let* ((rk (smartpacts.prize-draw.round-key "infl" 1))
       (sig (beacons.sig-for "infl" 1))
       (seed (mod (n_48867b242317a0216a67f8c7ca26696b5878e0e3.drand.verified-seed
                    (format "prize-draw|{}" [rk]) 20816502 sig)
                  1000000000000000000)))
  (smartpacts.prize-draw.draw "infl" 1 "k:2222222222222222222222222222222222222222222222222222222222222222" sig)
  (expect "VISION-INFLUENCE-3 the round settled on its pinned drand round and on that beacon's seed — the drawer chose neither"
    { "deciding-block": 20816502, "draw-seed": seed }
    (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
      { "deciding-block": (at 'deciding-block r), "draw-seed": (at 'draw-seed r) }))
  (expect "VISION-INFLUENCE-3b the whole crank share went to the drawer — there is no other crank role"
    [ ["draw" "k:2222222222222222222222222222222222222222222222222222222222222222"] ]
    (map (lambda (e:object) [ (at 2 (at 'params e)) (at 3 (at 'params e)) ])
         (filter (lambda (e:object) (= (at 'name e) "smartpacts.prize-draw.BOUNTY-PAID")) (env-events true)))))
(commit-tx)

;; ---- both written: rewritten by NOTHING, including a NEW round ---------------
(begin-tx)
(env-chain-data { "block-height": 1007 })
(expect-failure "VISION-INFLUENCE-4a a second draw is refused" "this round is already settled"
  (smartpacts.prize-draw.draw "infl" 1 "k:2222222222222222222222222222222222222222222222222222222222222222"
    (beacons.sig-for "infl" 1)))
(expect "VISION-INFLUENCE-4b a settled round is not decidable" false
  (smartpacts.prize-draw.decidable "infl" 1))
(expect-failure "VISION-INFLUENCE-4c escape is refused" "this round is settled"
  (smartpacts.prize-draw.escape "infl" 1))
(expect-failure "VISION-INFLUENCE-4d claim-escape is refused" "did not escape"
  (smartpacts.prize-draw.claim-escape "infl" 1 "k:1111111111111111111111111111111111111111111111111111111111111111"))
(expect "VISION-INFLUENCE-4e a drawn round's seed is recomputable by anyone from its pinned drand round and that beacon"
  (at 'draw-seed (smartpacts.prize-draw.get-round "infl" 1))
  (smartpacts.prize-draw.round-seed "infl|1" 20816502 (beacons.sig 20816502)))
(expect-failure "VISION-INFLUENCE-4e2 and the preview refuses the settled round rather than answer again"
  "this round is settled — read get-round for its result"
  (smartpacts.prize-draw.preview "infl" 1 (beacons.sig 20816502)))
(expect "VISION-INFLUENCE-4f the pair stands"
  { "decide-height": 20816502, "deciding-block": 20816502 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(rollback-tx)

(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] }
          , { "key": "5ea1000000000000000000000000000000000000000000000000000000000001"
            , "caps": [ (coin.TRANSFER "k:5ea1000000000000000000000000000000000000000000000000000000000001"
                                       (smartpacts.prize-draw.pool-account "infl") 1.0) ] } ])
(smartpacts.prize-draw.set-terms "infl" 2.0 0.50 [1.0] 0 1.0 0 200.0 0.20 [0 1])
(smartpacts.prize-draw.seed-raffle "infl" "k:5ea1000000000000000000000000000000000000000000000000000000000001" 1.0)
(expect "VISION-INFLUENCE-4g set-terms and seed-raffle after the draw leave the pair untouched"
  { "decide-height": 20816502, "deciding-block": 20816502 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(rollback-tx)
(env-sigs [])

;; the NEXT round opens by its first ticket and pins its own drand round;
;; round 1's pair is not the one being written
(begin-tx)
(env-chain-data { "block-height": 1100, "block-time": (time "2026-09-22T00:30:00Z") })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111"
                                       (smartpacts.prize-draw.pool-account "infl") 1.0) ] } ])
(expect "VISION-INFLUENCE-5 a later ticket opens round 2, not round 1"
  "bought 1 ticket(s) in infl round 2"
  (smartpacts.prize-draw.buy "infl" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (at 'expect (smartpacts.prize-draw.ticket-terms "infl"))))
(expect "VISION-INFLUENCE-5b round 2 pins its own drand round, from its own draw instant"
  20839302 (at 'decide-height (smartpacts.prize-draw.get-round "infl" 2)))
(expect "VISION-INFLUENCE-5c and round 1's pair stands"
  { "decide-height": 20816502, "deciding-block": 20816502 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(commit-tx)
(env-sigs [])

(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987"
            , "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(env-chain-data { "block-height": 1200, "block-time": (time "2026-09-23T00:00:00Z") })
(smartpacts.prize-draw.schedule-round "infl"
  (time "2026-09-24T00:00:00Z") (time "2026-09-24T01:00:00Z") (time "2026-09-24T01:00:00Z"))
(expect "VISION-INFLUENCE-5d nor does scheduling a third round touch it — every writer has now been tried"
  { "decide-height": 20816502, "deciding-block": 20816502 }
  (let ((r (smartpacts.prize-draw.get-round "infl" 1)))
    { "decide-height": (at 'decide-height r), "deciding-block": (at 'deciding-block r) }))
(rollback-tx)
(env-sigs [])

;; ---------------------------------------------------------------------------
;; VISION-EXPECT — A TICKET LANDS ON THE ROUND AND THE TERMS ITS BUYER READ, OR
;; NOT AT ALL. One operator key can change a game while a purchase is in flight;
;; the purchase states what it was signed for, so each of the three ways to make
;; it land on other terms ends in an aborted purchase and an untouched balance.
;; ---------------------------------------------------------------------------
(env-chain-data { "block-height": 1300, "block-time": (time "2026-11-09T00:00:00Z") })
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(begin-tx)
(smartpacts.prize-draw.create-raffle "vx1" 1.0 0.05 [0.5 0.3 0.2] 0 false 0.0 0 200.0 0.20 [1 1])
(smartpacts.prize-draw.create-raffle "vx2" 1.0 0.05 [0.5 0.3 0.2] 0 false 0.0 0 200.0 0.20 [1 1])
(smartpacts.prize-draw.create-raffle "vx3" 1.0 0.05 [0.5 0.3 0.2] 0 false 0.0 0 200.0 0.20 [1 1])
(smartpacts.prize-draw.schedule-round "vx1" (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))
(smartpacts.prize-draw.schedule-round "vx2" (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))
(smartpacts.prize-draw.schedule-round "vx3" (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))
(commit-tx)

;; PATH 1 — sales are open and unsold: the operator moves the opening one microsecond
;; ahead and re-terms in the same transaction; the buyer's purchase lands a block later.
(env-chain-data { "block-height": 1301, "block-time": (time "2026-11-10T12:00:00Z") })
(begin-tx)
(smartpacts.prize-draw.schedule-round "vx1" (add-time (time "2026-11-10T12:00:00Z") 0.000001) (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))
(smartpacts.prize-draw.set-terms "vx1" 1.0 0.999999999999 [1.0] 0 0.0 0 200.0 1.0 [1 1])
(commit-tx)
(env-chain-data { "block-height": 1302, "block-time": (time "2026-11-10T12:00:30Z") })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111" (smartpacts.prize-draw.pool-account "vx1") 10.0) ] } ])
(begin-tx)
(expect-failure "VISION-EXPECT-1 a window re-scheduled and re-termed ahead of its first ticket does not take the purchase signed for the published terms"
  "this is not the round, or not the terms, this ticket was signed for — read the game again"
  (smartpacts.prize-draw.buy "vx1" "k:1111111111111111111111111111111111111111111111111111111111111111" 10 [] (smartpacts.prize-draw.terms-digest 1 1.0 0.05 [0.5 0.3 0.2] false 0 200.0 0.20 (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))))
(commit-tx)

;; a live round for path 3, bought on the published terms
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111" (smartpacts.prize-draw.pool-account "vx3") 2.0) ] } ])
(begin-tx)
(smartpacts.prize-draw.buy "vx3" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (smartpacts.prize-draw.terms-digest 1 1.0 0.05 [0.5 0.3 0.2] false 0 200.0 0.20 (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z")))
(expect-failure "VISION-EXPECT-6 a ticket JOINS a live round only on that round's own statement: one stating another fee is refused"
  "this is not the round, or not the terms, this ticket was signed for — read the game again"
  (smartpacts.prize-draw.buy "vx3" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (smartpacts.prize-draw.terms-digest 1 1.0 0.999999999999 [0.5 0.3 0.2] false 0 200.0 0.20 (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))))
(commit-tx)

;; PATH 2 — at the closing instant of an unsold window the operator re-terms and re-opens
;; it one microsecond later; a purchase signed before the close is mined after it.
(env-chain-data { "block-height": 1303, "block-time": (time "2026-11-11T00:00:00Z") })
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(begin-tx)
(smartpacts.prize-draw.set-terms "vx2" 1.0 0.999999999999 [1.0] 0 0.0 0 200.0 1.0 [1 1])
(smartpacts.prize-draw.schedule-round "vx2" (add-time (time "2026-11-11T00:00:00Z") 0.000001) (time "2026-11-12T00:00:00Z") (time "2026-11-12T06:00:00Z"))
;; PATH 3 — with round 1 of vx3 sold and closing, the operator schedules round 2 right
;; after its close and re-terms "for future rounds".
(smartpacts.prize-draw.set-terms "vx3" 1.0 0.999999999999 [1.0] 0 0.0 0 200.0 1.0 [1 1])
(smartpacts.prize-draw.schedule-round "vx3" (add-time (time "2026-11-11T00:00:00Z") 0.000001) (time "2026-11-12T00:00:00Z") (time "2026-11-12T06:00:00Z"))
(commit-tx)
(env-chain-data { "block-height": 1304, "block-time": (time "2026-11-11T00:00:30Z") })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111" (smartpacts.prize-draw.pool-account "vx2") 10.0)
                      , (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111" (smartpacts.prize-draw.pool-account "vx3") 10.0) ] } ])
(begin-tx)
(expect-failure "VISION-EXPECT-2 a window re-termed and re-opened at its close does not take the purchase signed before the close"
  "this is not the round, or not the terms, this ticket was signed for — read the game again"
  (smartpacts.prize-draw.buy "vx2" "k:1111111111111111111111111111111111111111111111111111111111111111" 10 [] (smartpacts.prize-draw.terms-digest 1 1.0 0.05 [0.5 0.3 0.2] false 0 200.0 0.20 (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))))
(expect-failure "VISION-EXPECT-3 a purchase signed for the live round and mined after its close does not become the next round's first ticket"
  "this is not the round, or not the terms, this ticket was signed for — read the game again"
  (smartpacts.prize-draw.buy "vx3" "k:1111111111111111111111111111111111111111111111111111111111111111" 10 [] (smartpacts.prize-draw.terms-digest 1 1.0 0.05 [0.5 0.3 0.2] false 0 200.0 0.20 (time "2026-11-10T00:00:00Z") (time "2026-11-11T00:00:00Z") (time "2026-11-11T06:00:00Z"))))
(expect "VISION-EXPECT-4 the three hostile changes all landed, and no round opened on them: the buyer's only ticket is the one bought on the published terms"
  { "vx1": 0, "vx2": 0, "vx3": 1, "vx3-rake": 0.05, "hostile-rake": 0.999999999999 }
  { "vx1": (at 'round-seq (smartpacts.prize-draw.get-raffle "vx1")), "vx2": (at 'round-seq (smartpacts.prize-draw.get-raffle "vx2"))
  , "vx3": (at 'round-seq (smartpacts.prize-draw.get-raffle "vx3")), "vx3-rake": (at 'rake (smartpacts.prize-draw.get-round "vx3" 1))
  , "hostile-rake": (at 'rake (smartpacts.prize-draw.get-raffle "vx1")) })
(expect "VISION-EXPECT-5 and a buyer who reads the game again sees the new terms before signing anything"
  { "seq": 1, "rake": 0.999999999999, "tiers": [1.0], "bounty-share": 1.0, "on-sale": true }
  (let ((q (smartpacts.prize-draw.ticket-terms "vx2")))
    { "seq": (at 'seq q), "rake": (at 'rake q), "tiers": (at 'tiers q), "bounty-share": (at 'bounty-share q), "on-sale": (at 'on-sale q) }))
(commit-tx)
(env-sigs [])

;; PATH 4 — before a window opens the operator moves its three instants by 0.999 s, each
;; inside its own second; the buyer read the whole-second schedule.
(env-chain-data { "block-height": 1310, "block-time": (time "2026-11-12T00:00:00Z") })
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(begin-tx)
(smartpacts.prize-draw.create-raffle "vx4" 1.0 0.05 [0.5 0.3 0.2] 0 false 0.0 0 200.0 0.20 [1 1])
(smartpacts.prize-draw.schedule-round "vx4" (time "2026-11-13T00:00:00Z") (time "2026-11-14T00:00:00Z") (time "2026-11-14T06:00:01Z"))
(commit-tx)
(begin-tx)
(smartpacts.prize-draw.schedule-round "vx4" (add-time (time "2026-11-13T00:00:00Z") 0.999) (add-time (time "2026-11-14T00:00:00Z") 0.999) (add-time (time "2026-11-14T06:00:01Z") 0.999))
(commit-tx)
(env-chain-data { "block-height": 1311, "block-time": (time "2026-11-13T12:00:00Z") })
(env-sigs [ { "key": "1111111111111111111111111111111111111111111111111111111111111111"
            , "caps": [ (coin.TRANSFER "k:1111111111111111111111111111111111111111111111111111111111111111" (smartpacts.prize-draw.pool-account "vx4") 1.0) ] } ])
(begin-tx)
(expect-failure "VISION-EXPECT-7 a schedule moved by less than a second does not take the purchase signed for the whole-second one"
  "this is not the round, or not the terms, this ticket was signed for — read the game again"
  (smartpacts.prize-draw.buy "vx4" "k:1111111111111111111111111111111111111111111111111111111111111111" 1 [] (smartpacts.prize-draw.terms-digest 1 1.0 0.05 [0.5 0.3 0.2] false 0 200.0 0.20 (time "2026-11-13T00:00:00Z") (time "2026-11-14T00:00:00Z") (time "2026-11-14T06:00:01Z"))))
(commit-tx)
(env-sigs [])

(print "prize-draw vision suite complete")
