  { "names": (filter (lambda (n:string) (!= n "coin.TRANSFER")) (map (at 'name) (env-events true)))
  , "round-seq": (at 'round-seq (smartpacts.prize-draw.get-raffle "op"))
  , "rounds-used": (at 'rounds-used (smartpacts.prize-draw.get-raffle "op"))
  , "tickets": (at 'tickets (smartpacts.prize-draw.get-round "op" 1))
  , "sales": (at 'sales (smartpacts.prize-draw.get-round "op" 1))
  , "pending": (at 'pending (smartpacts.prize-draw.get-raffle "op")) })
(commit-tx)
(env-sigs [])

