  { "result": "bought 1 ticket(s) in opn-prev round 1", "tickets": 2 }
  { "result": (smartpacts.prize-draw.buy "opn-prev" "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 [])
  , "tickets": (at 'tickets (smartpacts.prize-draw.get-round "opn-prev" 1)) })
(commit-tx)
(env-chain-data { "block-height": 4001202, "block-time": (time "2026-10-15T06:00:00Z") })
(begin-tx)
(expect-failure "OPEN-N4 at closes-at exactly the round is not live: the ticket falls to the create path and is told the round is over and the next is unset"
  "sales are closed for this round — the next round is not scheduled yet"
  (smartpacts.prize-draw.buy "opn-prev" "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 []))
(rollback-tx)
(env-sigs [])

