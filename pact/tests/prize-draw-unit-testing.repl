;; (a) [1 2]: the recorder's share is FLOORED at 12 decimals, the drawer takes
;;     the rest — including the floor's dust
(env-chain-data { "block-height": 4010010, "block-time": (time "2026-10-15T14:00:00Z") })
(begin-tx)(smartpacts.prize-draw.open-draw "b2w" 1)(commit-tx)
