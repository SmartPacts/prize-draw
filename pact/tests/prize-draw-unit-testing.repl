(smartpacts.prize-draw.buy "strand-b" "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 [])
(commit-tx)
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] }
          , { "key": "fbdd00000000000000000000000000000000000000000000000000000000006a", "caps": [ (coin.TRANSFER "house-funder" (smartpacts.prize-draw.pool-account "strand-b") 5.0) ] } ])
(expect "STRAND-b1 round 1 of 1 is live and bound the bonus" 5.0
  (at 'seed-in (smartpacts.prize-draw.get-round "strand-b" 1)))
(expect-failure "STRAND-b2 a bonus on the last round is refused — no round could ever bind it"
