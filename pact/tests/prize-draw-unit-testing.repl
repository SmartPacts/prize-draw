(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(begin-tx)(smartpacts.prize-draw.schedule-round "opn-lim" (time "2026-11-01T00:00:00Z") (time "2026-11-30T00:00:00Z") (time "2026-11-30T12:00:00Z"))(commit-tx)
(env-sigs [])
(env-chain-data { "block-height": 4001102, "block-time": (time "2026-11-01T00:00:00Z") })
