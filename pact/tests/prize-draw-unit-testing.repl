(smartpacts.prize-draw.schedule-round "b2w" (time "2026-09-16T00:00:00Z") (time "2026-10-15T06:00:00Z") (time "2026-10-15T14:00:00Z"))
(smartpacts.prize-draw.schedule-round "b2z" (time "2026-09-16T00:00:00Z") (time "2026-10-15T06:00:00Z") (time "2026-10-15T14:00:00Z"))
(smartpacts.prize-draw.schedule-round "b2r" (time "2026-09-16T00:00:00Z") (time "2026-10-15T06:00:00Z") (time "2026-10-15T14:00:00Z"))
(smartpacts.prize-draw.schedule-round "b2m" (time "2026-09-16T00:00:00Z") (time "2026-10-15T06:00:00Z") (time "2026-10-15T14:00:00Z"))
(smartpacts.prize-draw.schedule-round "b2e" (time "2026-09-16T00:00:00Z") (time "2026-10-15T06:00:00Z") (time "2026-10-15T14:00:00Z"))
(commit-tx)
