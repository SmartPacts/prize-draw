(env-sigs [])

;; (c) set-terms lowering rounds-limit under a waiting bonus
(env-chain-data { "block-time": (time "2026-09-15T12:00:00Z") })
(begin-tx)
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
