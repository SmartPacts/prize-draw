            , "caps": [ (coin.TRANSFER "k:ca40100000000000000000000000000000000000000000000000000000000003" (smartpacts.prize-draw.pool-account "op") 3.0) ] } ])
(begin-tx)
(expect "OPEN-7 and a later buyer still pays the round's frozen 3.0, not the raffle's newer 5.0"
  { "result": "bought 1 ticket(s) in op round 1", "sales": 12.0, "ok": true }
  { "result": (smartpacts.prize-draw.buy "op" "k:ca40100000000000000000000000000000000000000000000000000000000003" 1 [] (at 'expect (smartpacts.prize-draw.ticket-terms "op")))
  , "sales": (at 'sales (smartpacts.prize-draw.get-round "op" 1))
  , "ok": (at 'ok (smartpacts.prize-draw.pool-status "op")) })
