  (smartpacts.prize-draw.set-terms "strand-c" 1.0 0.05 [1.0] 0 100.0 2 200.0 0.20 [1 1]))
(expect "STRAND-c3 and unlimited is allowed"
  "raffle strand-c re-termed for future rounds"
