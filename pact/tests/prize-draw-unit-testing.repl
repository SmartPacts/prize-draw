  { "round": { "price": 3.0, "rake": 0.20, "tiers": [1.0], "max-tickets": 50, "max-fund": 150.0, "bounty-share": 0.30, "bounty-split": [1 2] }
  , "raffle": { "price": 5.0, "rake": 0.30, "tiers": [0.5 0.5], "max-tickets": 0, "max-fund": 200.0, "bounty-share": 0.40, "bounty-split": [3 1] } }
  (let ((r (smartpacts.prize-draw.get-round "op" 1)) (g (smartpacts.prize-draw.get-raffle "op")))
