  "bought 1 ticket(s) in expire round 1"
  (smartpacts.prize-draw.buy "expire" "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 []))
(rollback-tx)
(env-chain-data { "block-height": 4003002, "block-time": (time "2026-10-15T06:00:00Z") })
(begin-tx)
(expect-failure "OPEN-N6 at the scheduled close exactly, with no ticket sold, the schedule has expired"
  "the scheduled round closed at 2026-10-15T06:00:00Z with no ticket sold — the operator must schedule again"
  (smartpacts.prize-draw.buy "expire" "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 []))
(rollback-tx)
(env-chain-data { "block-height": 4003003, "block-time": (time "2026-12-01T00:00:00Z") })
(begin-tx)
(expect-failure "EXPIRE-N1 and it stays expired, naming the same instant, however long after"
  "the scheduled round closed at 2026-10-15T06:00:00Z with no ticket sold — the operator must schedule again"
  (smartpacts.prize-draw.buy "expire" "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 []))
(rollback-tx)
(env-sigs [])
(begin-tx)
(expect-failure "EXPIRE-1 an expired schedule left no round row"
  "No value found in table smartpacts.prize-draw_rounds for key: expire|1"
  (smartpacts.prize-draw.get-round "expire" 1))
(expect "EXPIRE-1b nothing was written: no round, the bucket untouched, nothing bound, rounds-used unchanged, and the dead schedule still in the row until replaced"
  { "current": "", "round-seq": 0, "rounds-used": 0, "rounds-done": 0, "seed-bucket": 5.0, "bound": 0.0, "pending": 0.0
  , "next-opens-at": (time "2026-09-16T00:00:00Z"), "next-closes-at": (time "2026-10-15T06:00:00Z"), "next-draws-at": (time "2026-10-15T14:00:00Z") }
  (let ((g (smartpacts.prize-draw.get-raffle "expire")))
    { "current": (at 'current g), "round-seq": (at 'round-seq g), "rounds-used": (at 'rounds-used g), "rounds-done": (at 'rounds-done g)
    , "seed-bucket": (at 'seed-bucket g), "bound": (at 'bound g), "pending": (at 'pending g)
    , "next-opens-at": (at 'next-opens-at g), "next-closes-at": (at 'next-closes-at g), "next-draws-at": (at 'next-draws-at g) }))
(expect "EXPIRE-1c the pool holds exactly the bonus and the raffle is solvent"
  { "balance": 5.0, "bonus": 5.0, "ok": true }
  (let ((p (smartpacts.prize-draw.pool-status "expire"))) { "balance": (at 'balance p), "bonus": (at 'bonus p), "ok": (at 'ok p) }))
(rollback-tx)
;; the operator schedules again: S3, in the future of the clock
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] } ])
(begin-tx)
(expect "EXPIRE-2 scheduling again works — there is no round in the way"
  "raffle expire next round: sells 2026-12-02T00:00:00Z to 2026-12-31T00:00:00Z, draws at 2026-12-31T12:00:00Z"
  (smartpacts.prize-draw.schedule-round "expire" (time "2026-12-02T00:00:00Z") (time "2026-12-31T00:00:00Z") (time "2026-12-31T12:00:00Z")))
(expect "EXPIRE-2b and the row holds the new schedule"
  { "opens": (time "2026-12-02T00:00:00Z"), "closes": (time "2026-12-31T00:00:00Z"), "draws": (time "2026-12-31T12:00:00Z") }
  (let ((g (smartpacts.prize-draw.get-raffle "expire")))
    { "opens": (at 'next-opens-at g), "closes": (at 'next-closes-at g), "draws": (at 'next-draws-at g) }))
(commit-tx)
(env-sigs [])
(env-chain-data { "block-height": 4003004, "block-time": (time "2026-12-02T00:00:00Z") })
(env-sigs [ { "key": "a11ce00000000000000000000000000000000000000000000000000000000001"
            , "caps": [ (coin.TRANSFER "k:a11ce00000000000000000000000000000000000000000000000000000000001" (smartpacts.prize-draw.pool-account "expire") 1.0) ] } ])
(begin-tx)
(expect "EXPIRE-3 the first ticket into the new schedule creates ROUND 1 — the expired schedule never was one — and binds the waiting bonus"
  { "result": "bought 1 ticket(s) in expire round 1", "seq": 1, "opens-at": (time "2026-12-02T00:00:00Z"), "seed-in": 5.0, "rounds-used": 1, "seed-bucket": 0.0, "bound": 5.0 }
  (let ((res (smartpacts.prize-draw.buy "expire" "k:a11ce00000000000000000000000000000000000000000000000000000000001" 1 [])))
    { "result": res
    , "seq": (at 'seq (smartpacts.prize-draw.get-round "expire" 1))
    , "opens-at": (at 'opens-at (smartpacts.prize-draw.get-round "expire" 1))
    , "seed-in": (at 'seed-in (smartpacts.prize-draw.get-round "expire" 1))
    , "rounds-used": (at 'rounds-used (smartpacts.prize-draw.get-raffle "expire"))
    , "seed-bucket": (at 'seed-bucket (smartpacts.prize-draw.get-raffle "expire"))
    , "bound": (at 'bound (smartpacts.prize-draw.get-raffle "expire")) }))
(commit-tx)
(env-sigs [])

;; ---- BOUNTY2: the two-way split at the draw -------------------------------
;; Every raffle here: price 20.0, fee 10 %, crank share 0.5, ONE ticket. So
;; sales 20.0, fee 2.0, bounty pool 1.0, the winner takes 18.0 and revenue gets
;; fee - pool = 1.0. The recorder is r1 or a stand-in, the drawer m1, the buyer
;; x1 — three distinct accounts, so every delta is one transfer.
