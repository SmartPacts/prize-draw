;; ---- (6) an expired schedule, and EXPIRE: nothing was written ---------------
(env-chain-data { "block-height": 4003000, "block-time": (time "2026-09-15T12:00:00Z") })
(env-sigs [ { "key": "09b0f41a2f2b3b9f0c8ab6a1e0c1a4d1b1f0e2c3a4958677a5b4c3d2e1f00987", "caps": [ (smartpacts.prize-draw.OPERATOR) ] }
          , { "key": "fbdd00000000000000000000000000000000000000000000000000000000006a"
            , "caps": [ (coin.TRANSFER "house-funder" (smartpacts.prize-draw.pool-account "expire") 5.0) ] } ])
(begin-tx)
(smartpacts.prize-draw.create-raffle "expire" 1.0 0.05 [1.0] 0 false 5.0 0 200.0 0.20 [1 1])
(smartpacts.prize-draw.seed-raffle "expire" "house-funder" 5.0)
(smartpacts.prize-draw.schedule-round "expire" (time "2026-09-16T00:00:00Z") (time "2026-10-15T06:00:00Z") (time "2026-10-15T14:00:00Z"))
(commit-tx)
(env-sigs [])
;; nobody buys. One second before the close a ticket WOULD have opened it (rolled back)
(env-chain-data { "block-height": 4003001, "block-time": (time "2026-10-15T05:59:59Z") })
(env-sigs [ { "key": "a11ce00000000000000000000000000000000000000000000000000000000001"
