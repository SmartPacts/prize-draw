(env-sigs [ { "key": "7e57000000000000000000000000000000000000000000000000000000000071"
            , "caps": [ (coin.TRANSFER "k:7e57000000000000000000000000000000000000000000000000000000000071" (smartpacts.prize-draw.pool-account "b2w") 20.0)
                      , (coin.TRANSFER "k:7e57000000000000000000000000000000000000000000000000000000000071" (smartpacts.prize-draw.pool-account "b2z") 20.0)
                      , (coin.TRANSFER "k:7e57000000000000000000000000000000000000000000000000000000000071" (smartpacts.prize-draw.pool-account "b2r") 20.0)
                      , (coin.TRANSFER "k:7e57000000000000000000000000000000000000000000000000000000000071" (smartpacts.prize-draw.pool-account "b2m") 20.0)
                      , (coin.TRANSFER "k:7e57000000000000000000000000000000000000000000000000000000000071" (smartpacts.prize-draw.pool-account "b2e") 20.0) ] } ])
(begin-tx)
(smartpacts.prize-draw.buy "b2w" "k:7e57000000000000000000000000000000000000000000000000000000000071" 1 [])
(smartpacts.prize-draw.buy "b2z" "k:7e57000000000000000000000000000000000000000000000000000000000071" 1 [])
(smartpacts.prize-draw.buy "b2r" "k:7e57000000000000000000000000000000000000000000000000000000000071" 1 [])
