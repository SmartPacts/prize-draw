;; (d) a MODULE-ACCOUNT recorder cannot be paid (coin would refuse, aborting
;;     a draw whose escape is already closed): its share goes to the drawer
(env-chain-data { "block-height": 4013010, "block-time": (time "2026-10-15T14:00:00Z") })
(begin-tx)(smartpacts.prize-draw.open-draw "b2m" 1)(commit-tx)
(env-chain-data { "block-height": 4013013, "prev-block-hash": "b2m-block-4013012", "sender": "m:smartpacts.prize-draw:b2m" })
(begin-tx)
(free.block-history.attest)
(expect "BOUNTY2-M0 the record carries a module account as the attester — this raffle's own pool, no less"
  (smartpacts.prize-draw.pool-account "b2m")
  (at 'by (free.block-history.get-attested 4013012)))
(commit-tx)
(begin-tx)
(env-events true)
(let* ((drw0 (coin.get-balance "k:3111100000000000000000000000000000000000000000000000000000000011"))
       (rev0 (coin.get-balance "draw-revenue"))
       (res  (smartpacts.prize-draw.draw "b2m" 1 "k:3111100000000000000000000000000000000000000000000000000000000011"))
       (evs  (env-events true)))
  (expect "BOUNTY2-M1 the draw still settles — an unpayable recorder never wedges a round" "drawn"
    (at 'state (smartpacts.prize-draw.get-round "b2m" 1)))
  (expect "BOUNTY2-M2 the drawer absorbed the recorder's third: it took the whole pool" 1.0
    (- (coin.get-balance "k:3111100000000000000000000000000000000000000000000000000000000011") drw0))
  (expect "BOUNTY2-M3 only the draw role is announced, and nothing was transferred to the module account"
    { "roles": ["draw"], "to-module": 0 }
    { "roles": (map (lambda (e:object) (at 2 (at 'params e)))
                    (filter (lambda (e:object) (= (at 'name e) "smartpacts.prize-draw.BOUNTY-PAID")) evs))
    , "to-module": (length (filter (lambda (e:object)
                                     (and (= (at 'name e) "coin.TRANSFER")
                                          (= (at 1 (at 'params e)) "m:smartpacts.prize-draw:b2m")))
                                   evs)) })
  (expect "BOUNTY2-M4 revenue got fee - pool, unaffected" 1.0 (- (coin.get-balance "draw-revenue") rev0))
  (expect "BOUNTY2-M5 the pool is empty and the raffle solvent" true (at 'ok (smartpacts.prize-draw.pool-status "b2m"))))
(commit-tx)

