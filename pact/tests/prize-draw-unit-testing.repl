               , "max-fund": (at 'max-fund r), "bounty-share": (at 'bounty-share r), "bounty-split": (at 'bounty-split r) }
    , "raffle": { "price": (at 'price g), "rake": (at 'rake g), "tiers": (at 'tiers g), "max-tickets": (at 'max-tickets g)
                , "max-fund": (at 'max-fund g), "bounty-share": (at 'bounty-share g), "bounty-split": (at 'bounty-split g) } }))
(commit-tx)
